# BetterCMS delivery reads — a content:read key is enough for the site.
# On BetterCMS hosting these are injected automatically when you create the site
# from the Marketing Starter template; set them here only for local development.
NUXT_PUBLIC_BCMS_API_URL=https://api.bettercms.ai
NUXT_PUBLIC_BCMS_WORKSPACE=your-workspace-slug
# The project whose Home / About / Contact sections the build draws. Unset → those pages
# render their title only (no network call at build time).
NUXT_PUBLIC_BCMS_PROJECT_ID=your-project-id
# Only `npm run fetch-content` uses the key; it never reaches the built site.
BCMS_API_KEY=bcms_xxx
# Absolute origin for canonical + og:url (the deploy Action sets it). Unset → those tags are omitted.
# NUXT_PUBLIC_SITE_URL=https://www.example.com
